# Cloudflare static asset headers (copied to out/ by `next build`).
# Generated share images are written without a file extension, so name their type here.
/posts/*/opengraph-image
  Content-Type: image/png

# Scripts, styles and fonts under /_next/static/ have a content hash in their path, so a changed file
# gets a new URL. Browsers can keep them for a year without asking again.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
